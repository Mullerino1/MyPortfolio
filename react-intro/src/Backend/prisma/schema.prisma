// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
    id Int @unique
    title String
    description String?
    categories String?
    createdAt DateTime
    publishedAt DateTime
    public Boolean
    status String
}