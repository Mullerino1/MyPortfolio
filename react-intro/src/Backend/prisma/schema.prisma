// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
    id Int @unique
    title String
    description String?
    createdAt String
    publishedAt String
    public String
    status String

    categories Categories[] @relation("ProjectCategories")
}

model Categories {
  projectId   Int
  categories  String

  project Project @relation(fields: [projectId], references: [id], name: "ProjectCategories", onDelete: Cascade)

  @@id([projectId, categories])
}